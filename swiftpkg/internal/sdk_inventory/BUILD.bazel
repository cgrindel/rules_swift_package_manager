load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@cgrindel_bazel_starlib//bzlformat:defs.bzl", "bzlformat_pkg")

bzlformat_pkg(name = "bzlformat")

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "repository",
    srcs = ["repository.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
    deps = [
        ":inputs",
        ":parser",
        ":profiles",
        ":render",
    ],
)

exports_files(["fingerprint.py"])

bzl_library(
    name = "render",
    srcs = ["render.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
    deps = [":profiles"],
)

bzl_library(
    name = "inputs",
    srcs = ["inputs.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
)

bzl_library(
    name = "parser",
    srcs = ["parser.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
)

bzl_library(
    name = "profiles",
    srcs = ["profiles.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
)
