load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@cgrindel_bazel_starlib//bzlformat:defs.bzl", "bzlformat_pkg")

bzlformat_pkg(name = "bzlformat")

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "repository",
    srcs = ["repository.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
    deps = [":parser"],
)

bzl_library(
    name = "parser",
    srcs = ["parser.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
)
