"""Read the SDK aliases generated by rules_swift 4.2.1.

There is no public per-SDK inventory yet. Keep the generated-format adapter here,
separate from inference, and reject unknown alias shapes instead of guessing.
Availability is intersected across Xcodes and device/simulator variants. This
may omit valid dependencies but never assumes an unconfigured SDK is available.
"""

_SDK_BUILD = Label("@system_sdk//:BUILD.bazel")
_PLATFORM_SDKS = {
    "ios": ["iPhoneOS", "iPhoneSimulator"],
    "macos": ["MacOSX"],
    "tvos": ["AppleTVOS", "AppleTVSimulator"],
    "visionos": ["XROS", "XRSimulator"],
    "watchos": ["WatchOS", "WatchSimulator"],
}
_GROUPS = ["all_modules", "implicit_modules", "all_cross_import_overlays"]

def _unsupported():
    fail("Unsupported rules_swift SDK alias format. Disable system_sdk_deps for this package and use target_deps until the SDK inventory adapter is updated.")

def _aliases(contents):
    result = {}
    name = None
    branches = None
    state = None
    for raw_line in contents.splitlines():
        line = raw_line.strip()
        if state == None:
            if line == "alias(":
                state = "name"
            continue
        if state == "name":
            if not (line.startswith('name = "') and line.endswith('",')):
                _unsupported()
            name = line[len('name = "'):-2]
            branches = {}
            state = "select"
        elif state == "select":
            if line != "actual = select({":
                _unsupported()
            state = "branches"
        elif state == "branches":
            if line == "}),":
                state = "end"
            elif line.startswith('"') and line.endswith('",') and '\": \"' in line:
                branches.update(json.decode("{" + line[:-1] + "}"))
            else:
                _unsupported()
        elif state == "end":
            if line != ")" or name in result:
                _unsupported()
            result[name] = branches
            state = None
    if state != None:
        _unsupported()
    return result

def _inventory(hub, xcodes):
    result = {}
    for module, branches in hub.items():
        if module in _GROUPS or module.endswith("_clang"):
            continue
        if not branches:
            continue
        available = dict(_PLATFORM_SDKS)
        for actual in branches.values():
            repo, sep, target = actual.partition("//:")
            if not sep or not repo.startswith("@system_sdk_xcode_") or target != module:
                _unsupported()
            sdk_aliases = xcodes[repo].get(module, {})
            available = {
                platform: sdks
                for platform, sdks in available.items()
                if all([":" + sdk + "_sdk" in sdk_aliases for sdk in sdks])
            }
        if available:
            result[module] = sorted(available)
    return result

def _read(repository_ctx):
    hub = _aliases(repository_ctx.read(_SDK_BUILD))
    if not hub:
        # The non-Apple host stub has no module aliases.
        return {}
    canonical_name = _SDK_BUILD.repo_name
    if not canonical_name.endswith("system_sdk"):
        _unsupported()
    prefix = canonical_name[:-len("system_sdk")]
    xcodes = {}
    for branches in hub.values():
        for actual in branches.values():
            repo = actual.partition("//:")[0]
            if repo in xcodes:
                continue
            if not repo.startswith("@system_sdk_xcode_"):
                _unsupported()
            label = Label("@@{}{}//:BUILD.bazel".format(prefix, repo[1:]))
            xcodes[repo] = _aliases(repository_ctx.read(label))
    return _inventory(hub, xcodes)

system_sdk_modules = struct(
    read = _read,
    # Visible for adapter tests.
    aliases = _aliases,
    inventory = _inventory,
)
