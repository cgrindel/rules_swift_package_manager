load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@cgrindel_bazel_starlib//bzlformat:defs.bzl", "bzlformat_pkg")

bzlformat_pkg(name = "bzlformat")

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "slice_declarations",
    srcs = ["slice_declarations.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
    deps = [
        ":swift_deps_common",
        "//swiftpkg/internal:bazel_repo_names",
        "//swiftpkg/internal:bazel_target_mods",
        "//swiftpkg/internal:local_swift_package",
        "//swiftpkg/internal:manifest_files",
        "//swiftpkg/internal:manifest_shapes",
        "//swiftpkg/internal:pkginfo_dependencies",
        "//swiftpkg/internal:pkginfos",
        "//swiftpkg/internal:repository_utils",
        "//swiftpkg/internal:slice_merge",
        "//swiftpkg/internal:slice_messages",
        "//swiftpkg/internal:slices",
        "//swiftpkg/internal:stale_swift_package",
        "//swiftpkg/internal:staleness",
        "//swiftpkg/internal:swift_package",
        "//swiftpkg/internal:swift_package_aliases",
        "//swiftpkg/internal:swift_package_tool_repo",
        "@bazel_skylib//lib:paths",
    ],
)

bzl_library(
    name = "swift_deps_common",
    srcs = ["swift_deps_common.bzl"],
    visibility = ["//swiftpkg:__subpackages__"],
    deps = [
        "//swiftpkg/internal:bazel_repo_names",
        "@bazel_skylib//lib:paths",
    ],
)

bzl_library(
    name = "swift_deps",
    srcs = ["swift_deps.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":slice_declarations",
        ":swift_deps_common",
        "//swiftpkg/internal:bazel_repo_names",
        "//swiftpkg/internal:bazel_target_mods",
        "//swiftpkg/internal:local_swift_package",
        "//swiftpkg/internal:pkginfo_dependencies",
        "//swiftpkg/internal:pkginfos",
        "//swiftpkg/internal:registry_swift_package",
        "//swiftpkg/internal:repository_utils",
        "//swiftpkg/internal:swift_deps_info",
        "//swiftpkg/internal:swift_package",
        "//swiftpkg/internal:swift_package_tool",
        "//swiftpkg/internal:swift_package_tool_attrs",
        "//swiftpkg/internal:swift_package_tool_repo",
        "@bazel_skylib//lib:dicts",
        "@bazel_skylib//lib:paths",
    ],
)
