#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

# Use the Bazel binary specified by the integration test. Otherise, fall back
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

assert_match() {
  local pattern=${1}
  local actual="${2}"
  local err_msg="Expected to match. pattern: ${pattern}, actual: ${actual}"
  [[ "${actual}" =~ ${pattern} ]] || (echo >&2 "${err_msg}" && exit 1)
}

# Generate Swift external deps and update build files
"${bazel}" run //:tidy

# The checked-in slice was cached on macOS. Regenerating it there must not
# change it, and `bazel mod tidy` must find the root use_repo current. Linux
# hosts only build and test against it.
if [[ "$(uname)" == "Darwin" ]]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' EXIT
  cp -R swift_deps "${tmp}/swift_deps"
  cp MODULE.bazel "${tmp}/MODULE.bazel"

  "${bazel}" run @swift_package//:cache
  diff -r --exclude=.build "${tmp}/swift_deps" swift_deps \
    || (echo >&2 "The cache step changed the checked-in slice." && exit 1)

  "${bazel}" mod tidy
  diff "${tmp}/MODULE.bazel" MODULE.bazel \
    || (echo >&2 "bazel mod tidy changed MODULE.bazel." && exit 1)
  diff -r --exclude=.build "${tmp}/swift_deps" swift_deps \
    || (echo >&2 "bazel mod tidy changed the slice." && exit 1)
fi

# Ensure that it builds and tests pass
"${bazel}" test //...

# Run MyExecutable target
output="$( "${bazel}" run //Sources/MyExecutable 2>&1 )"
assert_match "Hello, World!" "${output}"
