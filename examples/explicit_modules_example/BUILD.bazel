load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

swift_library(
    name = "Main",
    srcs = ["Application.swift"],
    deps = ["@swiftpkg_explicitmodulesfixture//:Greeter"],
)

# Bundle the transitive Apple resources so Bundle.module can locate them at runtime.
macos_application(
    name = "explicit_modules_example",
    bundle_id = "com.example.explicit-modules",
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    deps = [":Main"],
)

build_test(
    name = "build_test",
    targets = [":explicit_modules_example"],
)

ios_application(
    name = "ios_explicit_modules_example",
    bundle_id = "com.example.explicit-modules.ios",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "15.0",
    deps = [":Main"],
)

# The standalone consumer has no provider/report yet. The runner explicitly
# executes this test once both components are present.
sh_test(
    name = "inference_report_test",
    srcs = ["verify_inference.sh"],
    args = ["$(location @swiftpkg_explicitmodulesfixture//:sdk_inference.json)"],
    data = ["@swiftpkg_explicitmodulesfixture//:sdk_inference.json"],
    tags = ["manual"],
)
