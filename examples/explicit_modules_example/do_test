#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

bazel="${BIT_BAZEL_BINARY:-bazel}"

# Resolve the system selection before Bazel so it becomes a tracked repo input.
if [[ -z "${DEVELOPER_DIR:-}" ]]; then
  DEVELOPER_DIR="$(xcode-select -p)"
  export DEVELOPER_DIR
fi

# Verify the same generated targets with implicit modules and both explicit modes.
"${bazel}" test //...
"${bazel}" run //:explicit_modules_example
# The SDK provider must land before the inference consumer. Missing profiles or
# provider wiring must fail this integration test rather than skip coverage.
for config in explicit_modules explicit_swift_modules inferred_modules; do
  "${bazel}" test --config="${config}" //...
  "${bazel}" run --config="${config}" //:explicit_modules_example
done

# Build one iOS simulator app with inferred SDK dependencies and no blanket SDK deps.
"${bazel}" test --config=inferred_modules //:inference_report_test
"${bazel}" build --config=inferred_modules --ios_multi_cpus=sim_arm64 //:ios_explicit_modules_example
