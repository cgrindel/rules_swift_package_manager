#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" > /dev/null && pwd)"

# Use the Bazel binary specified by the integration test. Otherise, fall back 
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

assert_match() {
  local pattern=${1}
  local actual="${2}"
  local err_msg="Expected to match. pattern: ${pattern}, actual: ${actual}"
  [[ "${actual}" =~ ${pattern} ]] || (echo >&2 "${err_msg}" && exit 1)
}

# Summarize `bazel aquery --output=text` output. Each action starts with a line
# that begins with `action '`; everything until the next such line belongs to
# that action, including its multi-line `Command Line:` block. Prints
# "<action_count> <actions_containing_the_flag>".
count_actions_with_flag() {
  local aquery_output="${1}"
  local flag="${2}"
  awk -v flag="${flag}" '
    /^action / {
      total += 1
      seen[total] = 0
    }
    total > 0 && index($0, flag) > 0 {
      seen[total] = 1
    }
    END {
      matching = 0
      for (idx = 1; idx <= total; idx += 1) {
        matching += seen[idx]
      }
      print total + 0, matching + 0
    }
  ' <<<"${aquery_output}"
}

# Generate Swift external deps and update build files
"${bazel}" run //:tidy

# Ensure that it builds and tests pass
"${bazel}" test //...

# Verify that the `bazel_target_add` tag in the MODULE.bazel appended the custom
# Bazel tag to the generated declaration.
tagged_target="@swiftpkg_swift_log//:Logging.rspm.__impl"
matches="$("${bazel}" query \
  "attr(tags, rspm_custom_tag, ${tagged_target})")"
assert_match "${tagged_target}" "${matches}"

# The modification must not leak to sibling declarations in the same repository.
untagged_target="@swiftpkg_swift_log//:InMemoryLogging.rspm.__impl"
matches="$("${bazel}" query \
  "attr(tags, rspm_custom_tag, ${untagged_target})")"
[[ -z "${matches}" ]] || (
  echo >&2 "Expected no custom tag on ${untagged_target}, found: ${matches}"
  exit 1
)

# Verify that the `bazel_target_add_select` tag in the MODULE.bazel appended a
# `select()` to the generated declaration. `bazel query` prints main repository
# labels without a repository part, so a `//:` key here means that the condition
# resolved back to this module and not to the generated repository.
decl="$("${bazel}" query --output=build "${tagged_target}")"
assert_match 'select\(\{"//:rspm_example_conditional": \["-DRSPM_EXAMPLE_CONDITIONAL"\]' \
  "${decl}"

# The generated BUILD file itself must spell the condition canonically. Without
# the `@@` prefix, the key would resolve inside the generated repository.
gen_build_file="$("${bazel}" query --output=location "${tagged_target}" \
  | sed -E 's/^(.*BUILD\.bazel):[0-9]+:[0-9]+:.*$/\1/')"
grep -q -F -- '"@@//:rspm_example_conditional"' "${gen_build_file}" || (
  echo >&2 "Expected a canonical select() key in ${gen_build_file}"
  exit 1
)

# Verify that the `bazel_target_set_bool` tag in the MODULE.bazel wrote a
# Starlark `bool`, not the string "False".
grep -q -E -- '^ +alwayslink = False,$' "${gen_build_file}" || (
  echo >&2 "Expected 'alwayslink = False' in ${gen_build_file}"
  exit 1
)

# Verify that the `select()` from `bazel_target_add_select` actually reaches the
# Swift compile actions, and only under the matching configuration. `bazel
# aquery` includes the command line by default (`--include_commandline` defaults
# to true). rules_swift emits a single `SwiftCompile` action today, but it splits
# compilation into `SwiftCompileModule`/`SwiftCompileCodegen` in some
# configurations, so match every mnemonic with that prefix.
conditional_copt="-DRSPM_EXAMPLE_CONDITIONAL"
tagged_compiles="mnemonic(\"SwiftCompile.*\", ${tagged_target})"
untagged_compiles="mnemonic(\"SwiftCompile.*\", ${untagged_target})"

# With the condition satisfied, every Swift compile action for the modified
# target must carry the conditional copt.
aquery_output="$("${bazel}" aquery --output=text \
  --define rspm_example_conditional=true "${tagged_compiles}")"
read -r action_count matching_count \
  < <(count_actions_with_flag "${aquery_output}" "${conditional_copt}")
[[ "${action_count}" -gt 0 ]] || (
  echo >&2 "Expected at least one Swift compile action for ${tagged_target}"
  exit 1
)
[[ "${matching_count}" -eq "${action_count}" ]] || (
  echo >&2 "Expected all ${action_count} Swift compile actions for" \
    "${tagged_target} to include ${conditional_copt}, found ${matching_count}"
  exit 1
)

# The modification must not leak to a sibling target in the same repository,
# even when the condition is satisfied. This query keeps the same `--define` as
# the previous one so that Bazel does not discard the analysis cache twice.
aquery_output="$("${bazel}" aquery --output=text \
  --define rspm_example_conditional=true "${untagged_compiles}")"
read -r action_count matching_count \
  < <(count_actions_with_flag "${aquery_output}" "${conditional_copt}")
[[ "${action_count}" -gt 0 ]] || (
  echo >&2 "Expected at least one Swift compile action for ${untagged_target}"
  exit 1
)
[[ "${matching_count}" -eq 0 ]] || (
  echo >&2 "Expected no Swift compile action for ${untagged_target} to include" \
    "${conditional_copt}, found ${matching_count}"
  exit 1
)

# Without the define, the condition is not satisfied and no Swift compile action
# for the modified target may carry the copt.
aquery_output="$("${bazel}" aquery --output=text "${tagged_compiles}")"
read -r action_count matching_count \
  < <(count_actions_with_flag "${aquery_output}" "${conditional_copt}")
[[ "${action_count}" -gt 0 ]] || (
  echo >&2 "Expected at least one Swift compile action for ${tagged_target}"
  exit 1
)
[[ "${matching_count}" -eq 0 ]] || (
  echo >&2 "Expected no Swift compile action for ${tagged_target} to include" \
    "${conditional_copt} without the define, found ${matching_count}"
  exit 1
)

# Run MyExecutable target
output="$("${bazel}" run //Sources/MyExecutable)"
assert_match "Good morning, World!" "${output}"
assert_match "Olivia .* 30 years old" "${output}"

# Run old-style executable in my_local_package
output="$("${bazel}" run @swiftpkg_my_local_package//:print-greeting)"
assert_match "Good evening, Jim!" "${output}"

# Buid and run the SwiftFormat alias
"${bazel}" run //:swiftformat -- --version

# Generate a resolution log file
res_log_path="${script_dir}/res_log.yml"
"${bazel}" run //:update_build_files --  "--resolution_log=${res_log_path}"
[[ -e "${res_log_path}" ]] || (echo >&2 "Expected to find a resolution log file at ${res_log_path}" && exit 1)

# Local Swift package paths must be stored relative to the workspace root so
# that a committed MODULE.bazel.lock is portable across machines. See GH-2405.
lock_file="${script_dir}/MODULE.bazel.lock"
if [[ ! -f "${lock_file}" ]]; then
  echo >&2 "ERROR: Expected ${lock_file} to be generated by the build."
  exit 1
fi
if ! grep -q '"path": "third_party/' "${lock_file}"; then
  echo >&2 "ERROR: ${lock_file} records no local Swift package paths." \
    "The absolute path check below is not exercising anything."
  exit 1
fi
if grep -q '"path": "/' "${lock_file}"; then
  echo >&2 "ERROR: ${lock_file} contains absolute local Swift package paths."
  grep '"path": "/' "${lock_file}" >&2
  exit 1
fi
