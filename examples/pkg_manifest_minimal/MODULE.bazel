bazel_dep(
    name = "rules_swift_package_manager",
    version = "0.0.0",
)
local_path_override(
    module_name = "rules_swift_package_manager",
    path = "../..",
)

bazel_dep(name = "cgrindel_bazel_starlib", version = "0.30.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The apple_support bazel_dep must come before the rules_cc.
# https://github.com/bazelbuild/apple_support#incompatible-toolchain-resolution
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(
    name = "rules_swift",
    version = "4.3.0",
    repo_name = "build_bazel_rules_swift",
)

# TODO(#2641): remove once a rules_swift release includes swift_toolchain_tool.
# The root module's override in rules_swift_package_manager does not reach
# this workspace.
git_override(
    module_name = "rules_swift",
    commit = "dd629b0cbb25c017e30fff3c40d0f0fddf653613",
    remote = "https://github.com/cgrindel/rules_swift.git",
)

apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)

# Demonstrate a buildozer-style modification of a generated declaration. The
# extra tag is inert as far as the build is concerned; `do_test` asserts that it
# shows up on the generated target.
swift_deps.bazel_target_add(
    attr = "tags",
    target = "@swiftpkg_swift_log//:Logging.rspm.__impl",
    values = ["rspm_custom_tag"],
)

# Demonstrate a `select()`-aware modification. The `//:rspm_example_conditional`
# key is canonicalized to `@@//:rspm_example_conditional` so that it still
# resolves to this module from inside the generated repository. The condition is
# never satisfied by the example's build, so the copt is inert; `do_test`
# asserts that the `select()` renders on the generated target.
swift_deps.bazel_target_add_select(
    attr = "copts",
    target = "@swiftpkg_swift_log//:Logging.rspm.__impl",
    values = {"//:rspm_example_conditional": ["-DRSPM_EXAMPLE_CONDITIONAL"]},
)

# Demonstrate a typed setter. The generated `swift_library` sets
# `alwayslink = True`; forcing it to `False` is inert for this example because
# every symbol it needs from `Logging` is referenced. `do_test` asserts that the
# value renders as a Starlark `bool` on the generated target.
swift_deps.bazel_target_set_bool(
    attr = "alwayslink",
    target = "@swiftpkg_swift_log//:Logging.rspm.__impl",
    value = False,
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_my_local_package",
    "swiftpkg_notthatamazingmodule",
    "swiftpkg_swift_argument_parser",
    "swiftpkg_swift_log",
    "swiftpkg_swiftformat",
)

# One `from_package` tag per slice. Include them after the root
# `use_extension` so that `bazel mod tidy` writes `use_repo` here rather than
# into a slice file.
include("//swift_deps/apple:inc.MODULE.bazel")
include("//swift_deps/linux:inc.MODULE.bazel")
