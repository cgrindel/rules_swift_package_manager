load("@cgrindel_bazel_starlib//bzltidy:defs.bzl", "tidy")
load("@cgrindel_bazel_starlib//updatesrc:defs.bzl", "updatesrc_update_all")

updatesrc_update_all(name = "update_all")

tidy(
    name = "tidy",
    targets = [
        ":update_all",
    ],
)

# Used by the `bazel_target_add_select` tag in the MODULE.bazel. It is never
# satisfied unless `--define rspm_example_conditional=true` is passed, so the
# conditional copt is inert for the build. It must be publicly visible because
# the `select()` that references it lives in a generated repository.
config_setting(
    name = "rspm_example_conditional",
    values = {"define": "rspm_example_conditional=true"},
    visibility = ["//visibility:public"],
)

alias(
    name = "swiftformat",
    # This is the executable product.
    # FYI. The identity for SwiftFormat in the swift package dump-package is
    # lowercase. That is why it is lowercase here.
    actual = "@swiftpkg_swiftformat//:swiftformat",
)
