load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@cgrindel_bazel_starlib//bzltidy:defs.bzl", "tidy")
load("@swift_gazelle_plugin//swift_deps_index:defs.bzl", "swift_deps_index")

tidy(
    name = "tidy",
    targets = [
        ":update_build_files",
    ],
)

alias(
    name = "update_swift_packages",
    actual = "//swift:update_swift_packages",
)

# MARK: - Gazelle

gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@bazel_skylib_gazelle_plugin//bzl",
        "@swift_gazelle_plugin//gazelle",
    ],
    visibility = ["//:__subpackages__"],
)

swift_deps_index(
    name = "swift_deps_index",
    swift_deps_info = "@swift_deps_info",
)

gazelle(
    name = "update_build_files",
    data = [
        ":swift_deps_index",
    ],
    extra_args = [
        "-swift_dependency_index=$(location :swift_deps_index)",
    ],
    gazelle = ":gazelle_bin",
)
