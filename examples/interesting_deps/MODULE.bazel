module(
    name = "interesting_deps_example",
    version = "0.0.0",
)

bazel_dep(
    name = "rules_swift_package_manager",
    version = "0.0.0",
)
local_path_override(
    module_name = "rules_swift_package_manager",
    path = "../..",
)

bazel_dep(name = "cgrindel_bazel_starlib", version = "0.30.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.10.0")

# The apple_support bazel_dep must come before the rules_cc.
# https://github.com/bazelbuild/apple_support#incompatible-toolchain-resolution
bazel_dep(name = "apple_support", version = "2.12.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(
    name = "rules_swift",
    version = "4.3.0",
    repo_name = "build_bazel_rules_swift",
)

# TODO(#2641): remove once a rules_swift release includes swift_toolchain_tool.
# The root module's override in rules_swift_package_manager does not reach
# this workspace.
git_override(
    module_name = "rules_swift",
    commit = "dd629b0cbb25c017e30fff3c40d0f0fddf653613",
    remote = "https://github.com/cgrindel/rules_swift.git",
)

bazel_dep(
    name = "rules_apple",
    version = "5.4.0",
    repo_name = "build_bazel_rules_apple",
)

apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)

# Example showing customization of the `swift_package` repo tool.
# To resolve: `bazel run @swift_package//:resolve`
# To update:  `bazel run @swift_package//:update`
swift_deps.configure_swift_package(
    cache_path = "spm-cache",
    config_path = "spm-config",
    dependency_caching = False,
    manifest_cache = "none",
    manifest_caching = False,
    security_path = "spm-security",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_cocoalumberjack",
    "swiftpkg_geoswift",
    "swiftpkg_libwebp_xcode",
    "swiftpkg_ocmock",
    "swiftpkg_opencombine",
    "swiftpkg_swift_log",
    "swiftpkg_swift_package_defines_example",
    "swiftpkg_swift_subprocess",
    "swiftpkg_yoti_doc_scan_ios",
)

# The slice's `from_package` tag. Include it after the root `use_extension` so
# that `bazel mod tidy` writes `use_repo` here rather than into the slice file.
include("//swift_deps/any:inc.MODULE.bazel")
