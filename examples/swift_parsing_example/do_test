#!/usr/bin/env bash

set -eou pipefail

# Use the Bazel binary specified by the integration test. Otherise, fall back
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

assert_match() {
  local pattern=${1}
  local actual="${2}"
  local err_msg="Expected to match. pattern: ${pattern}, actual: ${actual}"
  [[ "${actual}" =~ ${pattern} ]] || (echo >&2 "${err_msg}" && exit 1)
}

# Test resolving the package via the `swift_package` repo.
"${bazel}" run @swift_package//:resolve

# Ensure that it builds.
"${bazel}" build //...

# Ensure that the example runs.
output="$( "${bazel}" run //:swift_parsing_example 2>&1 )"
assert_match "user=frodo host=shire.example" "${output}"

# LocalLow declares macOS 10.15 / iOS 13 but depends on LocalHigh (macOS 13 /
# iOS 16). Its generated wrapper must carry the raised floors, as SwiftPM
# would apply to the module.
wrapper="$( "${bazel}" query --output=build '@swiftpkg_locallow//:LocalLow.rspm' 2>/dev/null )"
assert_match 'macos_minimum_os = "13.0"' "${wrapper}"
assert_match 'ios_minimum_os = "16.0"' "${wrapper}"
