load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@cgrindel_bazel_starlib//bzltidy:defs.bzl", "tidy")
load("@cgrindel_bazel_starlib//updatesrc:defs.bzl", "updatesrc_update_all")

updatesrc_update_all(name = "update_all")

tidy(
    name = "tidy",
    targets = [
        ":update_all",
    ],
)

swift_library(
    name = "SnapkitExample",
    srcs = [
        "AppDelegate.swift",
        "ListViewController.swift",
        "demos/BasicUIScrollViewController.swift",
        "demos/SimpleLayoutViewController.swift",
    ],
    module_name = "SnapkitExample",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@swiftpkg_snapkit//:SnapKit-Dynamic"],
)

ios_application(
    name = "iosapp",
    app_icons = glob(["Assets.xcassets/AppIcon.appiconset/**"]),
    bundle_id = "io.snapkit.Example-iOS",
    families = [
        "iphone",
    ],
    infoplists = [":Info.plist"],
    launch_storyboard = ":Base.lproj/LaunchScreen.storyboard",
    minimum_os_version = "14.0",
    resources = glob(
        ["Assets.xcassets/**"],
        exclude = ["Assets.xcassets/AppIcon.appiconset/**"],
    ),
    deps = [":SnapkitExample"],
)

build_test(
    name = "build_test",
    targets = [
        ":iosapp",
    ],
)
