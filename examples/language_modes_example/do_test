#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" > /dev/null && pwd)"

# Use the Bazel binary specified by the integration test. Otherise, fall back 
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

# Generate Swift external deps and update build files
"${bazel}" run //:tidy

# Ensure that it builds and tests pass
"${bazel}" test //...

# Local Swift package paths must be stored relative to the workspace root so
# that a committed MODULE.bazel.lock is portable across machines. See GH-2405.
lock_file="${script_dir}/MODULE.bazel.lock"
if [[ ! -f "${lock_file}" ]]; then
  echo >&2 "ERROR: Expected ${lock_file} to be generated by the build."
  exit 1
fi
if ! grep -q '"path": "third_party/' "${lock_file}"; then
  echo >&2 "ERROR: ${lock_file} records no local Swift package paths." \
    "The absolute path check below is not exercising anything."
  exit 1
fi
if grep -q '"path": "/' "${lock_file}"; then
  echo >&2 "ERROR: ${lock_file} contains absolute local Swift package paths."
  grep '"path": "/' "${lock_file}" >&2
  exit 1
fi
