    module_name = "language_modes_example",
    deps = [
        "@swiftpkg_swift_5_package//:Tools5",
        "@swiftpkg_swift_5_package_v6//:Tools5_Mode6",
        "@swiftpkg_swift_6_package//:Tools6",
        "@swiftpkg_swift_6_package//:Tools6_Mode5",
    ],
