#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

# Use the Bazel binary specified by the integration test. Otherwise, fall back
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

# Generate Swift external deps and update build files
"${bazel}" run //:tidy

# Ensure that it builds
"${bazel}" build //...

# Run the example binary to verify it works
"${bazel}" run //Sources/GRDBExample

# This example is run for MacOS and Linux. Run @swift_package//:update to
# ensure that it works on both platforms.
"${bazel}" run @swift_package//:update

# The checked-in apple slice was cached on macOS. Regenerating it there must
# not change it, and `bazel mod tidy` must find the root use_repo current.
# The linux slice comes from the generate_linux_slices workflow.
if [[ "$(uname)" == "Darwin" ]]; then
  slice_tmp="$(mktemp -d)"
  trap 'rm -rf "${slice_tmp}"' EXIT
  cp -R swift_deps "${slice_tmp}/swift_deps"
  cp MODULE.bazel "${slice_tmp}/MODULE.bazel"

  "${bazel}" run @swift_package//:cache
  diff -r --exclude=.build "${slice_tmp}/swift_deps/apple" swift_deps/apple \
    || (echo >&2 "The cache step changed the checked-in apple slice." && exit 1)

  "${bazel}" mod tidy
  diff "${slice_tmp}/MODULE.bazel" MODULE.bazel \
    || (echo >&2 "bazel mod tidy changed MODULE.bazel." && exit 1)
  diff -r --exclude=.build "${slice_tmp}/swift_deps" swift_deps \
    || (echo >&2 "bazel mod tidy changed a slice." && exit 1)
fi
