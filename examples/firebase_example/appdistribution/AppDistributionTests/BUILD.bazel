load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test", "ios_xctestrun_runner")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

# The direct simctl/xctest path can stall after simulator startup on Xcode 27.
# Run the same XCTest bundle through xcodebuild instead.
ios_xctestrun_runner(
    name = "xcodebuild_test_runner",
    create_xcresult_bundle = True,
    random = False,
)

swift_library(
    name = "AppDistributionTests",
    testonly = True,
    srcs = ["AppDistributionExampleTests.swift"],
    module_name = "AppDistributionTests",
    tags = ["manual"],
    deps = ["//appdistribution/AppDistributionExample"],
)

ios_unit_test(
    name = "FooTests",
    minimum_os_version = "15.0",
    runner = ":xcodebuild_test_runner",
    visibility = ["//visibility:private"],
    deps = [":AppDistributionTests"],
)
