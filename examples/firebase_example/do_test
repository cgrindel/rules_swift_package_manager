#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

print_and_run() {
  local cmd="${1}"
  shift 1
  printf >&2 "======================\n%s: %s %s\n======================\n" \
    "$(basename "${BASH_SOURCE[0]}")" "$(basename "${cmd}")" "$*"
  "${cmd}" "$@"
}

# Use the Bazel binary specified by the integration test. Otherise, fall back 
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

# Generate Swift external deps and update build files
print_and_run "${bazel}" run //:tidy

# Ensure that it builds and tests pass
print_and_run "${bazel}" test //...

# The analytics/AnalyticsExample generates an Xcode project using
# rules_xcodeproj. The following ensures that the project generates properly
# and that the project builds as rules_xcodeproj executes the build.
# Related:
# https://github.com/MobileNativeFoundation/rules_xcodeproj/issues/2703

# Generate the Xcode project
print_and_run "${bazel}" run //analytics/AnalyticsExample:xcodeproj

# Build the workspace
print_and_run "${bazel}" run //analytics/AnalyticsExample:xcodeproj -- \
  --generator_output_groups=all_targets 'build --remote_download_minimal'

# The checked-in slice for this host must regenerate byte-for-byte on this
# host, and `bazel mod tidy` must find the root use_repo current. An `any`
# slice is cached on macOS, so only macOS checks it.
if [[ -d swift_deps/apple && "$(uname)" == "Darwin" ]]; then
  host_slice="apple"
elif [[ -d swift_deps/linux && "$(uname)" == "Linux" ]]; then
  host_slice="linux"
elif [[ -d swift_deps/any && "$(uname)" == "Darwin" ]]; then
  host_slice="any"
else
  host_slice=""
fi
if [[ -z "${host_slice}" ]]; then
  echo "No checked-in slice for $(uname); skipped the cache-and-diff check."
else
  slice_tmp="$(mktemp -d)"
  trap 'rm -rf "${slice_tmp}"' EXIT
  cp -R swift_deps "${slice_tmp}/swift_deps"
  cp MODULE.bazel "${slice_tmp}/MODULE.bazel"

  "${bazel}" run @swift_package//:cache
  diff -r --exclude=.build \
    "${slice_tmp}/swift_deps/${host_slice}" "swift_deps/${host_slice}" \
    || (echo >&2 "The cache step changed the checked-in ${host_slice} slice." \
      && exit 1)

  "${bazel}" mod tidy
  diff "${slice_tmp}/MODULE.bazel" MODULE.bazel \
    || (echo >&2 "bazel mod tidy changed MODULE.bazel." && exit 1)
  diff -r --exclude=.build "${slice_tmp}/swift_deps" swift_deps \
    || (echo >&2 "bazel mod tidy changed a slice." && exit 1)
fi
