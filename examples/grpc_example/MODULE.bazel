"""
Example module for grpc + proto target generation.
"""

bazel_dep(
    name = "rules_swift_package_manager",
    version = "0.0.0",
)
local_path_override(
    module_name = "rules_swift_package_manager",
    path = "../..",
)

bazel_dep(name = "cgrindel_bazel_starlib", version = "0.30.0")

# Required by custom swift proto compiler plugin:
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "protobuf", version = "35.1")

# Required for proto_library targets:
bazel_dep(name = "rules_proto", version = "7.1.0")

# Required for compiling objc:
bazel_dep(name = "apple_support", version = "2.12.0")

# Required for swift_binary and swift_proto_library targets:
bazel_dep(name = "rules_swift", version = "4.3.0", repo_name = "build_bazel_rules_swift")

# TODO(#2641): remove once a rules_swift release includes swift_toolchain_tool.
# The root module's override in rules_swift_package_manager does not reach
# this workspace.
git_override(
    module_name = "rules_swift",
    commit = "dd629b0cbb25c017e30fff3c40d0f0fddf653613",
    remote = "https://github.com/cgrindel/rules_swift.git",
)

# Configure cc toolchain:
apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

# Required for SwiftProtobuf and GRPC Swift:
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_grpc_swift_2",
    "swiftpkg_grpc_swift_nio_transport",
    "swiftpkg_grpc_swift_protobuf",
    "swiftpkg_swift_algorithms",
    "swiftpkg_swift_asn1",
    "swiftpkg_swift_async_algorithms",
    "swiftpkg_swift_atomics",
    "swiftpkg_swift_certificates",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_crypto",
    "swiftpkg_swift_http_structured_headers",
    "swiftpkg_swift_http_types",
    "swiftpkg_swift_log",
    "swiftpkg_swift_nio",
    "swiftpkg_swift_nio_extras",
    "swiftpkg_swift_nio_http2",
    "swiftpkg_swift_nio_ssl",
    "swiftpkg_swift_nio_transport_services",
    "swiftpkg_swift_numerics",
    "swiftpkg_swift_protobuf",
    "swiftpkg_swift_service_lifecycle",
    "swiftpkg_swift_system",
)

# One `from_package` tag per slice. Include them after the root
# `use_extension` so that `bazel mod tidy` writes `use_repo` here rather than
# into a slice file.
include("//swift_deps/apple:inc.MODULE.bazel")
include("//swift_deps/linux:inc.MODULE.bazel")
