#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" > /dev/null && pwd)"

# Use the Bazel binary specified by the integration test. Otherise, fall back 
# to bazel.
bazel="${BIT_BAZEL_BINARY:-bazel}"

# GH249: Do not update build files until the Gazelle extension supports the
# shape of this example.
# # Generate Swift external deps and update build files
# bazel run //:tidy
# "${bazel}" run //:swift_update_pkgs

# Ensure that it builds and tests pass
"${bazel}" test //...

# Local Swift package paths must be stored relative to the workspace root so
# that a committed MODULE.bazel.lock is portable across machines. This example
# keeps Package.swift in a subdirectory, so the workspace root is derived from
# the `swift` label rather than the manifest directory. See GH-2405.
lock_file="${script_dir}/MODULE.bazel.lock"
if [[ ! -f "${lock_file}" ]]; then
  echo "ERROR: Expected ${lock_file} to be generated by the build." >&2
  exit 1
fi
if grep -q '"path": "/' "${lock_file}"; then
  echo "ERROR: ${lock_file} contains absolute local Swift package paths." >&2
  grep '"path": "/' "${lock_file}" >&2
  exit 1
fi
